{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/status.json",
      "destination": "/status.json"
    },
    {
      "source": "/config.json",
      "destination": "/config.json"
    }
  ],
  "headers": [
    {
      "source": "/(status|config).json",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, max-age=0"
        }
      ]
    }
  ]
}